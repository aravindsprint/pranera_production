+def _apply_current_roll_state(roll_no, roll):
+    """pranera_production compatibility. Once a roll has been through a
+    process (dyeing, stenter, inspection ...), Roll.item_code / batch /
+    roll_weight still hold the ORIGINAL greige values and the live values
+    are in current_item / current_batch / current_weight. Use the live
+    values for batch matching and quantity. A roll that is in process
+    (sitting in a workstation WIP against a Work Order) can't be picked.
+    No-op on sites without pranera_production (fields absent)."""
+    meta = frappe.get_meta("Roll")
+    if not meta.has_field("current_batch"):
+        return
+    cur = frappe.db.get_value(
+        "Roll", roll_no,
+        ["current_status", "current_item", "current_batch", "current_weight", "current_work_order"],
+        as_dict=True,
+    ) or {}
+    if cur.get("current_status") == "In Process":
+        frappe.throw(_("Roll {0} is in process for Work Order {1} — it can't be picked until it is manufactured").format(
+            roll_no, cur.get("current_work_order")))
+    if cur.get("current_item") or cur.get("current_batch"):
+        roll.item_code = cur.get("current_item") or roll.item_code
+        roll.batch = cur.get("current_batch") or roll.batch
+        if flt(cur.get("current_weight")):
+            roll.roll_weight = flt(cur.get("current_weight"))
+
